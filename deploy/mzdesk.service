[Unit]
Description=mzDesk (FastAPI, served at https://mzdesk.com/ via nginx)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mzdesk
Group=mzdesk
# the Docker socket (CFM-ID): only this service gets the group. Whoever controls the process could start containers as root, so the app never
# builds a Docker command from user text: the image and the arguments are fixed in ms2/cfmid_engine.py.
SupplementaryGroups=docker
WorkingDirectory=/opt/mzdesk
Environment=HOME=/var/lib/mzdesk
Environment=PYTHONUNBUFFERED=1
Environment=MZDESK_FEEDBACK_DIR=/var/lib/mzdesk/feedback
Environment=MZDESK_NEIMS_DIR=/var/lib/mzdesk/models/neims
Environment=MZDESK_MOLGPKA_DIR=/var/lib/mzdesk/models/molgpka
Environment=MZDESK_METHODS_DIR=/var/lib/mzdesk/data/methods
Environment=MZDESK_CACHE_DIR=/var/lib/mzdesk/cache
Environment=MZDESK_STATS_DB=/var/lib/mzdesk/stats.sqlite
Environment=MZDESK_LIBRARY_DIR=/var/lib/mzdesk/data/libraries
Environment=MZDESK_CCS_DIR=/var/lib/mzdesk/data/ccs
Environment=MZDESK_MONO=/var/lib/mzdesk/tools/mono/bin/mono
Environment=MZDESK_MSFINDER_DIR=/var/lib/mzdesk/tools/msfinder/MSFINDER_v3.73
Environment=MZDESK_FRIGID_DIR=/var/lib/mzdesk/tools/frigid
Environment=MZDESK_FRIGID_DEVICE=cpu
# MS/MS Annotation: "Run FRIGID" (Advanced) starts unticked here; people can tick it. The local version starts ticked.
Environment=MZDESK_ANNOTATION_FRIGID=off
# CFM-ID runs in Docker: the daemon must see the run's folder (the unit's /tmp is private), and the container is capped (see ms2/cfmid_engine.py)
Environment=MZDESK_CFMID_WORKDIR=/var/lib/mzdesk/cache/cfmid-work
Environment=MZDESK_CFMID_MEMORY=1g
Environment=MPLCONFIGDIR=/var/lib/mzdesk/cache/matplotlib
Environment=NUMBA_CACHE_DIR=/var/lib/mzdesk/cache/numba
# Secrets and mail settings: the admin password hash, the email / push channels for feedback and crash reports. Without the file,
# reports are still stored (and read at /reports) but not forwarded. The file stays on the server, never in this repo; see deploy/README.md.
EnvironmentFile=-/etc/mzdesk/mzdesk.env
# localhost only: nginx is the only way in. Real client IP comes from nginx (X-Forwarded-For, trusted from 127.0.0.1 only).
# --workers must stay 1: workflow tasks, the queue, fragment-view tasks and the heavy-task lock live in process memory, so with
# 2 workers a poll that lands on the other process gets 404 while the task is still running. More workers need a shared task store first.
ExecStart=/opt/mzdesk/.venv/bin/uvicorn mzdesk.api.app:app --host 127.0.0.1 --port 8599 --workers 1 \
  --no-server-header --proxy-headers --forwarded-allow-ips 127.0.0.1 --timeout-keep-alive 30 --limit-concurrency 64
Restart=always
RestartSec=3
TimeoutStopSec=20

# ---- sandbox: read-only system, writable data folder only, no privilege gain
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/mzdesk
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
UMask=0027
# ---- resource caps (2 CPU / 3.8 GB box shared with MCID and others). One uvicorn process holds the engines (BUDDY, PyTorch scores, the library
# index) and starts Mono (MS-FINDER) and FRIGID as children; the CFM-ID container is capped by Docker itself (MZDESK_CFMID_MEMORY).
# A FRIGID run peaks at 3.1 GB resident (measured, CPU, Quick mode), so the cap leaves the rest of the box little; when memory runs out the
# kernel takes mzdesk first (OOMScoreAdjust), not MCID or the other sites. More RAM on the droplet would take the pressure off.
MemoryHigh=3200M
MemoryMax=3400M
OOMScoreAdjust=300
TasksMax=256

[Install]
WantedBy=multi-user.target
