# Feedback email for mzDesk. Copy to /etc/mzdesk/mail.env (owner root, mode 0600) and restart the service:
#   install -d -m 750 /etc/mzdesk
#   install -m 600 deploy/mail.env.example /etc/mzdesk/mail.env
#   $EDITOR /etc/mzdesk/mail.env
#   systemctl daemon-reload && systemctl restart mzdesk
#
# Without MZDESK_SMTP_HOST the form still accepts messages, but only saves them under
# /var/lib/mzdesk/feedback/ (as .eml); nothing is emailed.

# Where the feedback goes. Defaults to this address when unset.
MZDESK_FEEDBACK_TO=feedback@example.org

# Any authenticated SMTP relay works. DigitalOcean allows outbound 587.
# Examples:
#   Resend:  smtp.resend.com, port 587, user "resend", password = API key, from a verified domain
#   Gmail:   smtp.gmail.com, port 587, user = the Gmail address, password = an app password (2FA required)
MZDESK_SMTP_HOST=smtp.example.org
MZDESK_SMTP_PORT=587
MZDESK_SMTP_USER=feedback@example.org
MZDESK_SMTP_PASSWORD=change-me
# Must be an address the relay is allowed to send as (a verified sender/domain). Defaults to MZDESK_SMTP_USER.
MZDESK_SMTP_FROM=feedback@example.org
# starttls (587) | ssl (465) | none
MZDESK_SMTP_SECURITY=starttls
