# mzDesk server settings. Copy to /etc/mzdesk/mzdesk.env (owner root, mode 0600) and restart the service:
#   install -d -m 750 /etc/mzdesk
#   install -m 600 deploy/mzdesk.env.example /etc/mzdesk/mzdesk.env
#   $EDITOR /etc/mzdesk/mzdesk.env
#   systemctl restart mzdesk
# Every setting is optional.

# ---- the maintainer's password for /stats and /reports (checked on the server)
# Make the two lines with:  python -m mzdesk.api.admin
# Without them the page-lock password applies, whose hash ships to every browser inside the page: set your own.
MZDESK_ADMIN_SALT=
MZDESK_ADMIN_HASH=

# ---- forwarding of feedback and crash reports. Every report is stored on the server and readable at /reports whatever is set here.
# Where email goes (default feedback@example.org).
MZDESK_FEEDBACK_TO=feedback@example.org

# Email through Resend's HTTPS API (this server cannot use SMTP: DigitalOcean blocks ports 25, 465 and 587).
# resend.com -> sign up with the address above -> API Keys -> Create. Until a domain is verified, Resend only delivers to the
# address of the account, from onboarding@resend.dev, which is all a report to yourself needs.
MZDESK_RESEND_API_KEY=
# After mzdesk.com is verified in Resend:  MZDESK_MAIL_FROM=mzDesk <reports@mzdesk.com>
MZDESK_MAIL_FROM=mzDesk <onboarding@resend.dev>

# Push to a phone through ntfy (no account): choose a long random topic, install the ntfy app, subscribe to the same topic.
# The push carries the reference, the kind and the page, never the message text.
#   MZDESK_NTFY_URL=https://ntfy.sh/mzdesk-<random letters and digits>
MZDESK_NTFY_URL=

# Email through SMTP (for a server that can reach one)
#   MZDESK_SMTP_HOST=smtp.example.org   MZDESK_SMTP_PORT=587   MZDESK_SMTP_USER=...   MZDESK_SMTP_PASSWORD=...
#   MZDESK_SMTP_FROM=...   MZDESK_SMTP_SECURITY=starttls   (starttls | ssl | none)
