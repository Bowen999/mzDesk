import streamlit as st
import theme


def render_structure():
    theme.tab_header(
        "Structure Annotation",
        subtitle="Assign a candidate structure to an unknown feature from its spectra and metadata.",
        kicker="annotation · in-silico",
    )
    theme.under_construction(
        "Structure Annotation",
        note="This module will propose and rank candidate structures for an unknown feature "
             "by combining MS¹/MS² evidence, adduct patterns and reference libraries.",
        eta="Planned — next milestone",
    )


def render_substructure():
    theme.tab_header(
        "Substructure Search",
        subtitle="Find molecules that contain a given substructure or SMARTS pattern.",
        kicker="search · SMARTS",
    )
    theme.under_construction(
        "Substructure Search",
        note="This module will let you draw or type a substructure / SMARTS query and screen "
             "a compound set for matches, with highlighted hits.",
        eta="Planned — next milestone",
    )
```