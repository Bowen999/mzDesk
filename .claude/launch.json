{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mzdesk",
      "runtimeExecutable": "/opt/anaconda3/bin/python3",
      "runtimeArgs": [
        "-m",
        "mzdesk",
        "--port",
        "8599"
      ],
      "port": 8599
    },
    {
      "name": "mzdesk-web",
      "runtimeExecutable": "npm",
