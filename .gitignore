__pycache__/
*.pyc
.DS_Store
# large vendored binary (unchanged; kept out of the local history)
mzdesk/lib/*.jar

# Obsidian personal config
.obsidian/

# setuptools editable install
*.egg-info/

# frontend
web/node_modules/
web/dist/
mzdesk/static/

# release build (deploy/build-release.sh): the wheel and version.json that mzdesk.com hands out
dist/

# copyrighted papers stay local (also in subfolders)
paper/literature/**/*.pdf

# CASMI2022 benchmark: raw data and large SIRIUS outputs stay local
benchmark/casmi2022/raw/
benchmark/casmi2022/sirius_run/ms/*.ms
benchmark/casmi2022/sirius_run/project*/
benchmark/casmi2022/sirius_run/logs/
benchmark/casmi2022/sirius_run/results/**/sirius_summaries/

# local scratch, benchmark runs and large data (not part of the app)
.screens/
.chrome-test/
.sirius_home/
benchmark/JESTR/
benchmark/MIST/
benchmark/std/
benchmark/casmi2022/jm_run/
benchmark/.mplcache/
research_inputs/
# Pan-ReDU snapshot: redistribution licence not confirmed yet
mzdesk/gnps/redu_cache/*.gz

# CASMI ablation: run outputs stay local; the scripts, README.md, scores.json, manifest.json and leak_lists/ are kept
benchmark/casmi2022/mzdesk_ablation_*/replay/
benchmark/casmi2022/mzdesk_ablation_*/store/
benchmark/casmi2022/mzdesk_ablation_*/standalone/
benchmark/casmi2022/mzdesk_ablation_*/step7_cache/
benchmark/casmi2022/mzdesk_ablation_*/worker_logs/
benchmark/casmi2022/mzdesk_ablation_*/.locks/
benchmark/casmi2022/mzdesk_ablation_*/.inflight/
benchmark/casmi2022/mzdesk_ablation_*/*.log
