import os, re, json, base64, tempfile, subprocess
from pathlib import Path
import streamlit as st
import pandas as pd
import plotly, plotly.graph_objects as go
from rdkit import Chem
from rdkit.Chem import Descriptors, rdMolDescriptors
from rdkit.Chem.Draw import rdMolDraw2D
from rdkit.Chem.MolStandardize import rdMolStandardize
from rdkit import RDLogger

RDLogger.DisableLog('rdApp.*')

JAR = Path(__file__).parent.parent / "lib" / "MetFragCommandLine-2.5.2.jar"


@st.cache_resource
def get_plotlyjs():
    return plotly.offline.get_plotlyjs()


def render_frag_png(smi, size=(240, 170)):
    """Best-effort 2D depiction of a (possibly artifact-laden) MetFrag fragment SMILES -> base64 PNG str."""
    if not smi:
        return ""
    m = Chem.MolFromSmiles(smi)
    if m is None:
        m = Chem.MolFromSmiles(smi, sanitize=False)
        if m is None:
            return ""
        try:
            m.UpdatePropertyCache(strict=False)
            Chem.SanitizeMol(m, sanitizeOps=Chem.SanitizeFlags.SANITIZE_ALL ^
                             Chem.SanitizeFlags.SANITIZE_PROPERTIES ^ Chem.SanitizeFlags.SANITIZE_KEKULIZE)
        except Exception:
            pass
    try:
        d = rdMolDraw2D.MolDraw2DCairo(*size)
        rdMolDraw2D.PrepareAndDrawMolecule(d, m)
        d.FinishDrawing()
        return base64.b64encode(d.GetDrawingText()).decode()
    except Exception:
        return ""


@st.cache_data(show_spinner=False)
def render_input_png(smiles, size=(560, 360)):
    """Render the INPUT molecule to PNG bytes for display (None if the SMILES is invalid)."""
    if not smiles or not smiles.strip():
        return None
    mol = Chem.MolFromSmiles(smiles)
    if mol is None:
        return None
    d = rdMolDraw2D.MolDraw2DCairo(*size)
    rdMolDraw2D.PrepareAndDrawMolecule(d, mol)
    d.FinishDrawing()
    return d.GetDrawingText()


def decode_metfrag_ion(s):
    """Decode a MetFrag ion-formula string like '[C3H8O5P-H]-H-' -> (net_formula_dict, total_H_shift)."""
    m = re.match(r'\[([^\]]+)\](.*)$', s)
    if not m:
        return {}, 0
    inner, tail = m.group(1), m.group(2)
    hshift = 0
    for a in re.finditer(r'([+-])(\d*)H(?![a-z])', inner):
        hshift += (1 if a.group(1) == '+' else -1) * (int(a.group(2)) if a.group(2) else 1)
    base = re.sub(r'[+-]\d*H(?![a-z])', '', inner)
    for a in re.finditer(r'([+-])(\d*)H', tail):
        hshift += (1 if a.group(1) == '+' else -1) * (int(a.group(2)) if a.group(2) else 1)
    counts = {}
    for el, n in re.findall(r'([A-Z][a-z]?)(\d*)', base):
        if el:
            counts[el] = counts.get(el, 0) + (int(n) if n else 1)
    counts['H'] = counts.get('H', 0) + hshift
    return counts, hshift


def ion_mz(counts, positive):
    """m/z of a singly-charged ion. Cation: -1 electron; anion: +1 electron."""
    mass = sum(ATOMIC.get(el, 0.0) * n for el, n in counts.items())
    return mass + (-ELECTRON if positive else ELECTRON)


def formula_str(counts):
    order = ['C', 'H', 'N', 'O', 'P', 'S', 'F', 'Cl', 'Br', 'Na', 'K']
    parts = []
    for el in order:
        n = counts.get(el, 0)
        if n:
            parts.append(el + (str(n) if n != 1 else ''))
    for el, n in counts.items():
        if el not in order and n:
            parts.append(el + (str(n) if n != 1 else ''))
    return ''.join(parts)


def parse_spectrum(text):
    """Parse a peak list into [(mz, intensity), ...]."""
    text = (text or "").strip()
    if not text:
        return []
    peaks = []
    if ":" in text:
        for tok in text.split():
            bits = tok.split(":")
            try:
                mz = float(bits[0])
            except (ValueError, IndexError):
                continue
            inten = 1.0
            if len(bits) > 1 and bits[1]:
                try:
                    inten = float(bits[1])
                except ValueError:
                    inten = 1.0
            peaks.append((mz, inten))
    else:
        for line in text.splitlines():
            parts = [p for p in re.split(r"[\s,]+", line.strip()) if p]
            if not parts:
                continue
            try:
                mz = float(parts[0])
            except ValueError:
                continue
            inten = float(parts[1]) if len(parts) > 1 else 1.0
            peaks.append((mz, inten))
    agg = {}
    for mz, i in peaks:
        agg[round(mz, 5)] = max(agg.get(round(mz, 5), 0.0), i)
    return sorted(agg.items())


def parse_metfrag_psv(psv_path):
    """Parse FragmentSmilesPSV: returns dicts keyed by float(mz) -> ion-formula str / fragment-SMILES."""
    lines = Path(psv_path).read_text(encoding='utf-8').strip().splitlines()
    formulas, smiles = {}, {}
    if len(lines) < 2:
        return formulas, smiles
    for field in lines[1].split('|'):
        field = field.strip()
        if re.search(r'\d+\.\d+:\[', field):
            for e in field.split(';'):
                if ':' in e:
                    k, v = e.split(':', 1); formulas[float(k)] = v
        elif re.search(r'\d+\.\d+:[A-Za-z(\[]', field) and not smiles:
            for e in field.split(';'):
                if ':' in e:
                    k, v = e.split(':', 1); smiles[float(k)] = v
    return formulas, smiles


HOVER_TEMPLATE = r'''<!doctype html><html><head><meta charset="utf-8">
